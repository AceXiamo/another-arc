{
  "manifest_version": 3,
  "name": "API Probe",
  "version": "1.0.0",
  "description": "Test fixture: exercises chrome.* APIs and reports which ones work.",
  "background": { "service_worker": "sw.js" },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webNavigation",
    "webRequest",
    "contextMenus",
    "alarms",
    "cookies",
    "notifications",
    "declarativeNetRequest",
    "offscreen",
    "sidePanel"
  ],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": { "default_title": "API Probe", "default_popup": "popup.html", "default_icon": "icon.png" },
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "options_page": "options.html",
  "icons": { "48": "icon.png" }
}
